<Window x:Class="PRCar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRCar — конфигуратор автомобиля" Width="740" Height="800"
        MinWidth="520" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB" Foreground="#243044" FontFamily="Segoe UI" FontSize="14" Language="ru-RU"
        Closing="WindowClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StepTitle" Text="Шаг 1 из 5 · Модель и двигатель" Style="{StaticResource Heading}"/>
        <ProgressBar x:Name="Progress" Grid.Row="1" Minimum="1" Maximum="5" Value="1" Height="7" Margin="0,0,0,20"/>
        <TabControl x:Name="Steps" Grid.Row="2" BorderThickness="0" Background="Transparent">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Выберите автомобиль" Style="{StaticResource Heading}"/>
                        <Label Content="Модель и базовая цена" Target="{Binding ElementName=ModelBox}" Padding="0"/>
                        <ComboBox x:Name="ModelBox" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"/>
                        <Label Content="Двигатель и доплата" Target="{Binding ElementName=EngineBox}" Padding="0"/>
                        <ComboBox x:Name="EngineBox" ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}"/>
                        <TextBlock Text="Цены учебные, фиксированные. Сумма внизу учитывает все выбранные параметры." TextWrapping="Wrap" Foreground="#58677C"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Цвет и дополнительные опции" Style="{StaticResource Heading}"/>
                        <Label Content="Цвет кузова и доплата" Target="{Binding ElementName=ColorBox}" Padding="0"/>
                        <ComboBox x:Name="ColorBox" ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}"/>
                        <TextBlock Text="Дополнительные опции" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <CheckBox Content="Климат-контроль · 70 000 ₽" IsChecked="{Binding Climate}"/>
                        <CheckBox Content="Камера заднего вида · 40 000 ₽" IsChecked="{Binding Camera}"/>
                        <CheckBox Content="Подогрев сидений · 30 000 ₽" IsChecked="{Binding HeatedSeats}"/>
                        <TextBlock Text="{Binding OptionsPrice, StringFormat='Всего за опции — {0:N0} ₽'}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Проверьте комплектацию" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding CarSummary}" Style="{StaticResource Summary}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Рассчитайте кредит" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding DownPercent, StringFormat='Первоначальный взнос — {0}%'}"/>
                        <Slider Value="{Binding DownPercent, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,18" ToolTip="Доля стоимости автомобиля, которую вы оплачиваете сразу"/>
                        <TextBlock Text="{Binding Months, StringFormat='Срок кредита — {0} мес.'}"/>
                        <Slider Value="{Binding Months, UpdateSourceTrigger=PropertyChanged}" Minimum="12" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,18" ToolTip="Срок от 12 до 96 месяцев"/>
                        <TextBlock Text="{Binding LoanSummary}" Style="{StaticResource Summary}"/>
                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#58677C" Text="Учебный расчёт при 7,5% годовых. Проценты = сумма кредита × 0,075 × месяцы / 12. Платёж = (сумма кредита + проценты) / месяцы."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="Оформите заявку" Style="{StaticResource Heading}"/>
                        <Label Content="Имя · от 2 символов" Target="{Binding ElementName=NameBox}" Padding="0"/>
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Телефон · 10–15 цифр" Target="{Binding ElementName=PhoneBox}" Padding="0"/>
                        <TextBox x:Name="PhoneBox" MaxLength="15" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Электронная почта · например, name@mail.ru" Target="{Binding ElementName=EmailBox}" Padding="0"/>
                        <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Кнопка оформления доступна, когда все контакты заполнены корректно." Foreground="#58677C" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding CarSummary}" Style="{StaticResource Summary}"/>
                        <TextBlock Text="{Binding LoanSummary}" Style="{StaticResource Summary}" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Total, StringFormat='Стоимость автомобиля — {0:N0} ₽'}"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
            <Button x:Name="BackButton" Grid.Row="1" Content="Назад" Click="GoBack"
                    IsEnabled="False" HorizontalAlignment="Left" Margin="0"
                    ToolTip="Вернуться к предыдущему шагу"/>
            <Button x:Name="NextButton" Grid.Row="1" Content="Далее" Click="GoNext"
                    HorizontalAlignment="Right" ToolTip="Перейти к следующему шагу"/>
            <Button x:Name="SubmitButton" Grid.Row="1" Content="Оформить заявку" Click="Submit"
                    Visibility="Collapsed" IsEnabled="{Binding ContactsValid}"
                    HorizontalAlignment="Right" ToolTip="Сохранить заявку на этом компьютере"/>
        </Grid>
    </Grid>
</Window>
